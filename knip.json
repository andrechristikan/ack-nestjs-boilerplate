{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "src/main.ts",
        "src/migration.ts",
        "src/instrument.ts",
        "scripts/*.ts"
    ],
    "ignoreExportsUsedInFile": true,
    "ignoreFiles": [],
    "rules": {
        "files": "error",
        "dependencies": "error",
        "devDependencies": "error",
        "exports": "error",
        "nsExports": "error",
        "types": "error",
        "nsTypes": "error",
        "enumMembers": "error",
        "namespaceMembers": "error",
        "catalog": "error"
    },
    "ignoreDependencies": [
        "pino-pretty",
        "pino-roll",
        "@types/supertest",
        "supertest"
    ]
}
