<html>
<body style="font-family: Arial, sans-serif; color: #333; background-color: #ffffff;">
<p>Hi {{username}},</p>
<br/>
<table border="1" cellpadding="8" cellspacing="0" style="border-collapse: collapse; width: 100%;">
  <thead>
    <tr style="background-color: {{statusColor}}; color: #ffffff;">
      <th colspan="2" style="text-align: left;">{{title}}</th>
    </tr>
  </thead>
  <tbody>
    <tr><td colspan="2">{{description}}</td></tr>
    {{#if link}}
    <tr><td>Download</td><td><a href="{{link}}">Download</a> (expires {{linkExpiredAt}})</td></tr>
    {{/if}}
    <tr><td>Support Email</td><td>{{supportEmail}}</td></tr>
    <tr><td>Website</td><td>{{homeUrl}}</td></tr>
  </tbody>
</table>
<br/>
<p>By: {{homeName}}.</p>
</body>
</html>
