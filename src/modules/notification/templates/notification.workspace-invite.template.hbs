<html>
<body style="font-family: Arial, sans-serif; color: #333; background-color: #ffffff;">
<p>Hello,</p>
<br/>
<p>{{inviterName}} has invited you to join the workspace <strong>{{workspaceName}}</strong> as <strong>{{workspaceMemberRole}}</strong>.</p>
<table border="1" cellpadding="8" cellspacing="0" style="border-collapse: collapse; width: 100%;">
  <thead>
    <tr style="background-color: #f2f2f2;">
      <th style="text-align: left;">Field</th>
      <th style="text-align: left;">Value</th>
    </tr>
  </thead>
  <tbody>
    <tr><td>Workspace</td><td>{{workspaceName}}</td></tr>
    <tr><td>Invited By</td><td>{{inviterName}}</td></tr>
    <tr><td>Role</td><td>{{workspaceMemberRole}}</td></tr>
    <tr><td>Accept Invite Link</td><td>{{inviteAcceptLink}}</td></tr>
    <tr><td>Expired At</td><td>{{expiredAt}}</td></tr>
    <tr><td>Reference</td><td>{{reference}}</td></tr>
    <tr><td>Support Email</td><td>{{supportEmail}}</td></tr>
    <tr><td>Website</td><td>{{homeUrl}}</td></tr>
  </tbody>
</table>
<br/>
<p>By: {{homeName}}.</p>
</body>
</html>
