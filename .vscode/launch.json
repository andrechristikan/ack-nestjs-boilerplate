{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Nest Framework",
            "preLaunchTask": "Build Project",
            "program": "${workspaceFolder}/dist/main.js",
            "runtimeArgs": [
                "--nolazy",
                "--enable-source-maps",
                "--import",
                "./dist/instrument.js"
            ],
            "sourceMaps": true,
            "outFiles": ["${workspaceFolder}/dist/**/*.js"],
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
