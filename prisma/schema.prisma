datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

model ApiKey {
  id       String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type     EnumApiKeyType @default(default)
  name     String
  key      String
  hash     String
  isActive Boolean        @default(true)
  startAt  DateTime?
  endAt    DateTime?

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@unique(fields: [key])
  @@unique(fields: [hash])
  @@index(fields: [isActive, type, createdAt(sort: Desc)])
  @@index(fields: [name])
  @@map("api_keys")
}

model Role {
  id          String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  description String?
  type        EnumRoleType @default(user)

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  policies  Policy[]      @relation("RolePolicy")
  abilities RoleAbility[]
  users     User[]        @relation("UserRole")

  @@unique(fields: [name])
  @@index(fields: [type, createdAt(sort: Desc)])
  @@map("roles")
}

model RoleAbility {
  id      String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  roleId  String @db.Uuid
  subject String
  action  String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique(fields: [roleId, subject, action])
  @@index(fields: [subject, action])
  @@map("role_abilities")
}

model Policy {
  id      String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  roleId  String             @db.Uuid
  subject EnumPolicySubject
  action  EnumPolicyAction[]

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  role Role @relation("RolePolicy", fields: [roleId], references: [id], onDelete: Cascade)

  @@unique(fields: [roleId, subject])
  @@map("policies")
}

model Country {
  id         String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name       String
  alpha2Code String
  alpha3Code String
  continent  String
  timezone   String

  phoneCodes    String[]
  mobileNumbers UserMobileNumber[] @relation("UserMobileNumberCountry")
  users         User[]             @relation("UserCountry")

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@unique(fields: [alpha2Code])
  @@unique(fields: [alpha3Code])
  @@index(fields: [continent])
  @@index(fields: [name])
  @@map("countries")
}

model UserMobileNumber {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @db.Uuid
  countryId  String    @db.Uuid
  phoneCode  String
  number     String
  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  country       Country        @relation("UserMobileNumberCountry", fields: [countryId], references: [id])
  user          User           @relation("UserMobileNumberUser", fields: [userId], references: [id])
  verifications Verification[] @relation("UserMobileNumberVerification")

  @@unique(fields: [userId, countryId, phoneCode, number])
  @@index(fields: [userId, isVerified])
  @@map("user_mobile_numbers")
}

model User {
  id                     String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name                   String?
  username               String
  isVerified             Boolean            @default(false)
  verifiedAt             DateTime?
  email                  String
  roleId                 String             @db.Uuid
  password               String?
  passwordExpired        DateTime?
  passwordCreated        DateTime?
  passwordAttempt        Int?
  signUpAt               DateTime           @default(now())
  signUpFrom             EnumUserSignUpFrom
  signUpWith             EnumUserSignUpWith
  status                 EnumUserStatus     @default(active)
  gender                 EnumUserGender?
  countryId              String             @db.Uuid
  lastLoginAt            DateTime?
  lastIPAddress          String?            @db.Inet
  lastLoginFrom          EnumUserLoginFrom?
  lastLoginWith          EnumUserLoginWith?
  lastWorkspaceId        String?            @db.Uuid
  lastWorkspaceChangedAt DateTime?

  createdAt DateTime  @default(now())
  createdBy String?   @db.Uuid
  updatedAt DateTime  @updatedAt
  updatedBy String?   @db.Uuid
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  termsOfServiceAccepted Boolean @default(false)
  privacyAccepted        Boolean @default(false)
  cookiesAccepted        Boolean @default(false)
  marketingAccepted      Boolean @default(false)

  mobileNumbers           UserMobileNumber[]         @relation("UserMobileNumberUser")
  verifications           Verification[]             @relation("UserVerifications")
  passwordHistories       PasswordHistory[]          @relation("UserPasswordHistories")
  activityLogs            ActivityLog[]              @relation("UserActivityLogs")
  role                    Role                       @relation("UserRole", fields: [roleId], references: [id])
  country                 Country                    @relation("UserCountry", fields: [countryId], references: [id])
  sessions                Session[]                  @relation("UserSessions")
  acceptances             TermPolicyUserAcceptance[] @relation("TermPolicyUserAcceptanceUser")
  forgotPasswords         ForgotPassword[]           @relation("UserForgotPassword")
  twoFactor               TwoFactor?                 @relation("UserTwoFactor")
  photo                   UserPhoto?                 @relation("UserPhoto")
  notifications           Notification[]             @relation("UserNotifications")
  notificationSettings    NotificationUserSetting[]  @relation("UserNotificationSettings")
  deviceOwnerships        DeviceOwnership[]          @relation("DeviceOwnershipUser")
  featureFlagUsers        FeatureFlagUser[]          @relation("FeatureFlagUserUser")
  revokedSessions         Session[]                  @relation("SessionRevokedByUser")
  revokedDeviceOwnerships DeviceOwnership[]          @relation("DeviceOwnershipRevokedByUser")
  workspaceMembers        WorkspaceMember[]          @relation("UserWorkspaceMembers")
  workspaceJoinRequests   WorkspaceJoinRequest[]     @relation("UserWorkspaceJoinRequests")
  projectMembers          ProjectMember[]            @relation("UserProjectMembers")

  @@unique(fields: [username])
  @@unique(fields: [email])
  @@index(fields: [id, deletedAt])
  @@index(fields: [email, deletedAt])
  @@index(fields: [status, deletedAt, createdAt(sort: Desc)])
  @@index(fields: [roleId, status, deletedAt])
  @@index(fields: [countryId, status, signUpAt(sort: Desc)])
  @@map("users")
}

model UserPhoto {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String  @unique @db.Uuid
  bucket       String
  key          String
  cdnUrl       String?
  completedUrl String
  mime         String
  extension    String
  access       String

  user User @relation("UserPhoto", fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_photos")
}

model Verification {
  id             String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String               @db.Uuid
  mobileNumberId String?              @db.Uuid
  to             String
  type           EnumVerificationType
  token          String
  expiredAt      DateTime
  verifiedAt     DateTime?
  isUsed         Boolean              @default(false)
  reference      String

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid

  user         User              @relation("UserVerifications", fields: [userId], references: [id])
  mobileNumber UserMobileNumber? @relation("UserMobileNumberVerification", fields: [mobileNumberId], references: [id])

  @@unique(fields: [reference])
  @@index(fields: [token, expiredAt, isUsed, type])
  @@index(fields: [userId, type, isUsed])
  @@map("verifications")
}

model PasswordHistory {
  id        String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String                  @db.Uuid
  password  String
  type      EnumPasswordHistoryType
  expiredAt DateTime

  user User @relation("UserPasswordHistories", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid

  @@index(fields: [userId, expiredAt(sort: Desc)])
  @@index(fields: [userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("password_histories")
}

model ActivityLog {
  id          String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String                @db.Uuid
  workspaceId String?               @db.Uuid
  action      EnumActivityLogAction
  ipAddress   String?               @db.Inet
  userAgent   Json
  description String
  geoLocation Json?
  metadata    Json?

  user      User       @relation("UserActivityLogs", fields: [userId], references: [id])
  workspace Workspace? @relation("WorkspaceActivityLogs", fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid

  @@index(fields: [userId, workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [workspaceId, createdAt(sort: Desc)])
  @@index(fields: [userId, action, createdAt(sort: Desc)])
  @@map("activity_logs")
}

model Session {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String    @db.Uuid
  deviceOwnershipId String    @db.Uuid
  jti               String
  ipAddress         String?   @db.Inet
  userAgent         Json
  geoLocation       Json?
  expiredAt         DateTime
  revokedAt         DateTime?
  isRevoked         Boolean   @default(false)
  revokedById       String?   @db.Uuid

  revokedBy       User?           @relation("SessionRevokedByUser", fields: [revokedById], references: [id])
  user            User            @relation("UserSessions", fields: [userId], references: [id])
  deviceOwnership DeviceOwnership @relation("DeviceOwnershipSessions", fields: [deviceOwnershipId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@unique(fields: [userId, jti])
  @@index(fields: [userId, expiredAt(sort: Desc), isRevoked])
  @@index(fields: [userId, isRevoked, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [isRevoked, expiredAt(sort: Asc)])
  @@index(fields: [userId, deviceOwnershipId, isRevoked])
  @@index(fields: [deviceOwnershipId])
  @@map("sessions")
}

model Device {
  id                   String                          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fingerprint          String
  name                 String?
  platform             EnumDevicePlatform
  lastActiveAt         DateTime                        @default(now())
  notificationToken    String?
  notificationProvider EnumDeviceNotificationProvider?

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  ownerships DeviceOwnership[] @relation("DeviceOwnershipDevice")

  @@unique(fields: [fingerprint])
  @@map("devices")
}

model DeviceOwnership {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deviceId     String    @db.Uuid
  userId       String    @db.Uuid
  revokedAt    DateTime?
  isRevoked    Boolean   @default(false)
  revokedById  String?   @db.Uuid
  lastActiveAt DateTime  @default(now())

  biometricEnabled   Boolean            @default(false)
  biometricToken     String?
  biometricType      EnumBiometricType?
  biometricEnabledAt DateTime?

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  revokedBy User?     @relation("DeviceOwnershipRevokedByUser", fields: [revokedById], references: [id])
  device    Device    @relation("DeviceOwnershipDevice", fields: [deviceId], references: [id])
  user      User      @relation("DeviceOwnershipUser", fields: [userId], references: [id])
  sessions  Session[] @relation("DeviceOwnershipSessions")

  @@index(fields: [deviceId, revokedAt])
  @@index(fields: [userId, isRevoked, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [userId, revokedAt])
  @@index(fields: [deviceId, userId, revokedAt])
  @@map("device_ownerships")
}

model TwoFactor {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String    @db.Uuid
  secret        String?
  iv            String?
  enabled       Boolean   @default(false)
  requiredSetup Boolean   @default(false)
  confirmedAt   DateTime?
  lastUsedAt    DateTime?
  attempt       Int       @default(0)

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  user        User                  @relation("UserTwoFactor", fields: [userId], references: [id])
  backupCodes TwoFactorBackupCode[]

  @@unique(fields: [userId])
  @@map("two_factors")
}

model TwoFactorBackupCode {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  twoFactorId String    @db.Uuid
  codeHash    String
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  twoFactor TwoFactor @relation(fields: [twoFactorId], references: [id], onDelete: Cascade)

  @@unique(fields: [twoFactorId, codeHash])
  @@index(fields: [twoFactorId, usedAt])
  @@map("two_factor_backup_codes")
}

model TermPolicy {
  id          String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type        EnumTermPolicyType
  contents    TermPolicyContent[]
  version     Int                  @default(1)
  status      EnumTermPolicyStatus @default(draft)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  userAcceptances TermPolicyUserAcceptance[] @relation("TermPolicyUserAcceptanceTermPolicy")

  @@unique(fields: [type, version])
  @@index(fields: [type, status, publishedAt(sort: Desc)])
  @@map("term_policies")
}

model TermPolicyContent {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  termPolicyId String  @db.Uuid
  language     String
  bucket       String
  key          String
  cdnUrl       String?
  completedUrl String
  mime         String
  extension    String
  access       String
  size         Int

  termPolicy TermPolicy @relation(fields: [termPolicyId], references: [id], onDelete: Cascade)

  @@unique(fields: [termPolicyId, language])
  @@map("term_policy_contents")
}

model TermPolicyUserAcceptance {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String   @db.Uuid
  termPolicyId String   @db.Uuid
  acceptedAt   DateTime @default(now())

  user       User       @relation("TermPolicyUserAcceptanceUser", fields: [userId], references: [id])
  termPolicy TermPolicy @relation("TermPolicyUserAcceptanceTermPolicy", fields: [termPolicyId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid

  @@unique(fields: [userId, termPolicyId])
  @@index(fields: [termPolicyId, acceptedAt(sort: Desc)])
  @@index(fields: [userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("term_policy_user_acceptances")
}

model FeatureFlag {
  id             String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key            String
  description    String
  isEnable       Boolean @default(true)
  rolloutPercent Int     @default(100)
  metadata       Json?

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  targetUsers FeatureFlagUser[] @relation("FeatureFlagUserFeatureFlag")

  @@unique(fields: [key])
  @@index(fields: [isEnable])
  @@map("feature_flags")
}

model FeatureFlagUser {
  id            String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  featureFlagId String @db.Uuid
  userId        String @db.Uuid

  featureFlag FeatureFlag @relation("FeatureFlagUserFeatureFlag", fields: [featureFlagId], references: [id], onDelete: Cascade)
  user        User        @relation("FeatureFlagUserUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique(fields: [featureFlagId, userId])
  @@index(fields: [userId])
  @@map("feature_flag_users")
}

model ForgotPassword {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @db.Uuid
  to        String
  token     String
  expiredAt DateTime
  resetAt   DateTime?
  isUsed    Boolean   @default(false)
  reference String

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid

  user User @relation("UserForgotPassword", fields: [userId], references: [id])

  @@unique(fields: [reference])
  @@index(fields: [token, expiredAt, isUsed])
  @@map("forgot_passwords")
}

model Notification {
  id       String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId   String                   @db.Uuid
  type     EnumNotificationType
  priority EnumNotificationPriority @default(normal)
  title    String
  body     String
  metadata Json?
  isRead   Boolean                  @default(false)
  readAt   DateTime?

  user       User                   @relation("UserNotifications", fields: [userId], references: [id])
  deliveries NotificationDelivery[] @relation("NotificationDeliveries")

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@index(fields: [userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [userId, isRead, createdAt(sort: Desc)])
  @@index(fields: [userId, type, createdAt(sort: Desc)])
  @@index(fields: [userId, priority, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationDelivery {
  id             String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  notificationId String                  @db.Uuid
  channel        EnumNotificationChannel
  sentAt         DateTime?
  processedAt    DateTime?
  failureTokens  String[]                @default([])

  notification Notification @relation("NotificationDeliveries", fields: [notificationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique(fields: [notificationId, channel])
  @@index(fields: [channel, createdAt(sort: Desc)])
  @@map("notification_deliveries")
}

model NotificationUserSetting {
  id       String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId   String                  @db.Uuid
  channel  EnumNotificationChannel
  type     EnumNotificationType
  isActive Boolean                 @default(true)

  user User @relation("UserNotificationSettings", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@unique(fields: [userId, channel, type])
  @@index(fields: [userId, isActive])
  @@map("notification_user_settings")
}

model Workspace {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  slug        String
  description String?
  isPublic    Boolean @default(false)

  members      WorkspaceMember[]
  invites      WorkspaceInvite[]
  joinRequests WorkspaceJoinRequest[]
  projects     Project[]
  activityLogs ActivityLog[]          @relation("WorkspaceActivityLogs")

  createdAt DateTime  @default(now())
  createdBy String?   @db.Uuid
  updatedAt DateTime  @updatedAt
  updatedBy String?   @db.Uuid
  deletedAt DateTime?

  @@unique(fields: [slug])
  @@index(fields: [isPublic, deletedAt, createdAt(sort: Desc)])
  @@index(fields: [deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [deletedAt, name])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String                  @db.Uuid
  userId      String                  @db.Uuid
  role        EnumWorkspaceMemberRole
  joinedAt    DateTime                @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation("UserWorkspaceMembers", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@unique(fields: [workspaceId, userId])
  @@index(fields: [userId])
  @@index(fields: [workspaceId, role, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [workspaceId, joinedAt, id])
  @@map("workspace_members")
}

model WorkspaceInvite {
  id               String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId      String                    @db.Uuid
  email            String
  workspaceRole    EnumWorkspaceMemberRole
  projectId        String?                   @db.Uuid
  projectRole      EnumProjectMemberRole?
  token            String
  reference        String
  expiredAt        DateTime
  status           EnumWorkspaceInviteStatus @default(pending)
  invitedByUserId  String                    @db.Uuid
  acceptedAt       DateTime?
  acceptedByUserId String?                   @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  project   Project?  @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@unique(fields: [token])
  @@unique(fields: [reference])
  @@index(fields: [workspaceId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [email, status])
  @@index(fields: [token, expiredAt, status])
  @@index(fields: [workspaceId, expiredAt])
  @@map("workspace_invites")
}

model WorkspaceJoinRequest {
  id               String                         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId      String                         @db.Uuid
  userId           String                         @db.Uuid
  status           EnumWorkspaceJoinRequestStatus @default(pending)
  message          String?
  rejectReasonCode EnumWorkspaceJoinRejectReason?
  reviewedByUserId String?                        @db.Uuid
  reviewedAt       DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation("UserWorkspaceJoinRequests", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@index(fields: [workspaceId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [userId, status])
  @@map("workspace_join_requests")
}

model Project {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String  @db.Uuid
  name        String
  slug        String
  description String?

  workspace Workspace         @relation(fields: [workspaceId], references: [id])
  members   ProjectMember[]
  invites   WorkspaceInvite[]

  createdAt DateTime  @default(now())
  createdBy String?   @db.Uuid
  updatedAt DateTime  @updatedAt
  updatedBy String?   @db.Uuid
  deletedAt DateTime?

  @@unique(fields: [workspaceId, slug])
  @@index(fields: [workspaceId, deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@map("projects")
}

model ProjectMember {
  id        String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId String                @db.Uuid
  userId    String                @db.Uuid
  role      EnumProjectMemberRole
  joinedAt  DateTime              @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation("UserProjectMembers", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@unique(fields: [projectId, userId])
  @@index(fields: [userId])
  @@index(fields: [projectId, role, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [projectId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [projectId, joinedAt, id])
  @@map("project_members")
}

enum EnumUserGender {
  male
  female
}

enum EnumUserStatus {
  active
  inactive
  blocked
}

enum EnumUserSignUpFrom {
  system
  admin
  website
  mobile
}

enum EnumUserSignUpWith {
  credential
  socialGoogle
  socialApple
}

enum EnumUserLoginFrom {
  website
  mobile
}

enum EnumUserLoginWith {
  credential
  socialGoogle
  socialApple
}

enum EnumRoleType {
  superAdmin
  admin
  user
}

enum EnumPolicyAction {
  manage
  read
  create
  update
  delete
}

enum EnumPolicySubject {
  all
  apiKey
  role
  user
  session
  activityLog
  passwordHistory
  termPolicy
  featureFlag
  device
  workspace
  project
}

enum EnumApiKeyType {
  system
  default
}

enum EnumTermPolicyType {
  termsOfService
