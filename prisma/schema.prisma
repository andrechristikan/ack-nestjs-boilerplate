datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma-client"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

model ApiKey {
  id       String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type     EnumApiKeyType @default(default)
  name     String
  key      String
  hash     String
  isActive Boolean        @default(true)
  startAt  DateTime?
  endAt    DateTime?

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@unique(fields: [key])
  @@unique(fields: [hash])
  @@index(fields: [isActive, type, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [name, id])
  @@map("api_keys")
}

model Role {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  scope          EnumRoleScope
  key            String
  name           String
  description    String?
  policyRevision Int           @default(0)
  isImmutable    Boolean       @default(false)

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  policies                        Policy[]          @relation("RolePolicy")
  users                           User[]            @relation("UserRole")
  workspaceMembers                WorkspaceMember[] @relation("WorkspaceMemberRole")
  projectMembers                  ProjectMember[]   @relation("ProjectMemberRole")
  workspaceInvitesAsWorkspaceRole WorkspaceInvite[] @relation("WorkspaceInviteWorkspaceRole")
  workspaceInvitesAsProjectRole   WorkspaceInvite[] @relation("WorkspaceInviteProjectRole")

  @@unique(fields: [scope, key])
  @@index(fields: [scope, createdAt(sort: Desc), id(sort: Desc)])
  @@map("roles")
}

model Policy {
  id      String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  roleId  String             @db.Uuid
  subject EnumPolicySubject
  action  EnumPolicyAction[]

  conditions Json?
  inverted   Boolean @default(false)
  reason     String?

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  role Role @relation("RolePolicy", fields: [roleId], references: [id], onDelete: Cascade)

  @@index(fields: [roleId, subject])
  @@map("policies")
}

model Country {
  id         String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name       String
  alpha2Code String
  alpha3Code String
  continent  String
  timezone   String

  phoneCode     String[]
  mobileNumbers UserMobileNumber[] @relation("UserMobileNumberCountry")
  users         User[]             @relation("UserCountry")

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@unique(fields: [alpha2Code])
  @@unique(fields: [alpha3Code])
  @@index(fields: [name])
  @@map("countries")
}

model UserMobileNumber {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @db.Uuid
  countryId  String    @db.Uuid
  phoneCode  String
  number     String
  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  country       Country        @relation("UserMobileNumberCountry", fields: [countryId], references: [id], onDelete: Cascade)
  user          User           @relation("UserMobileNumberUser", fields: [userId], references: [id], onDelete: Cascade)
  verifications Verification[] @relation("UserMobileNumberVerification")

  @@unique(fields: [userId, countryId, phoneCode, number])
  @@map("user_mobile_numbers")
}

model UserSocial {
  id       String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId   String            @db.Uuid
  provider EnumUserLoginWith
  subject  String

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid

  user User @relation("UserSocialUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique(fields: [provider, subject])
  @@unique(fields: [userId, provider])
  @@map("user_socials")
}

model User {
  id                     String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name                   String?
  username               String
  isVerified             Boolean            @default(false)
  verifiedAt             DateTime?
  email                  String
  roleId                 String             @db.Uuid
  password               String?
  passwordExpired        DateTime?
  passwordCreated        DateTime?
  passwordAttempt        Int                @default(0)
  passwordLockedUntil    DateTime?
  signUpAt               DateTime           @default(now())
  signUpFrom             EnumUserSignUpFrom
  signUpWith             EnumUserSignUpWith
  status                 EnumUserStatus     @default(active)
  gender                 EnumUserGender?
  countryId              String             @db.Uuid
  lastLoginAt            DateTime?
  lastIPAddress          String?            @db.Inet
  lastLoginFrom          EnumUserLoginFrom?
  lastLoginWith          EnumUserLoginWith?
  lastWorkspaceId        String?            @db.Uuid
  lastWorkspaceChangedAt DateTime?

  createdAt DateTime  @default(now())
  createdBy String?   @db.Uuid
  updatedAt DateTime  @updatedAt
  updatedBy String?   @db.Uuid
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  mobileNumbers             UserMobileNumber[]         @relation("UserMobileNumberUser")
  socials                   UserSocial[]               @relation("UserSocialUser")
  verifications             Verification[]             @relation("UserVerifications")
  passwordHistories         PasswordHistory[]          @relation("UserPasswordHistories")
  activityLogs              ActivityLog[]              @relation("UserActivityLogs")
  role                      Role                       @relation("UserRole", fields: [roleId], references: [id], onDelete: Cascade)
  country                   Country                    @relation("UserCountry", fields: [countryId], references: [id], onDelete: Cascade)
  sessions                  Session[]                  @relation("UserSessions")
  acceptances               TermPolicyUserAcceptance[] @relation("TermPolicyUserAcceptanceUser")
  forgotPasswords           ForgotPassword[]           @relation("UserForgotPassword")
  mfa                       Mfa?                       @relation("UserMfa")
  mfaTotp                   MfaTotp?                   @relation("UserMfaTotp")
  mfaPasskeys               MfaPasskey[]               @relation("UserMfaPasskeys")
  mfaChallenges             MfaChallenge[]             @relation("UserMfaChallenges")
  notifications             Notification[]             @relation("UserNotifications")
  notificationSettings      NotificationUserSetting[]  @relation("UserNotificationSettings")
  deviceOwnerships          DeviceOwnership[]          @relation("DeviceOwnershipUser")
  revokedSessions           Session[]                  @relation("SessionRevokedByUser")
  revokedDeviceOwnerships   DeviceOwnership[]          @relation("DeviceOwnershipRevokedByUser")
  workspaceMembers          WorkspaceMember[]          @relation("UserWorkspaceMembers")
  workspaceJoinRequests     WorkspaceJoinRequest[]     @relation("UserWorkspaceJoinRequests")
  projectMembers            ProjectMember[]            @relation("UserProjectMembers")
  termPolicyRecipients      TermPolicyRecipient[]      @relation("UserTermPolicyRecipients")
  photo                     UserPhoto?                 @relation("UserPhoto")
  featureFlagUsers          FeatureFlagUser[]          @relation("FeatureFlagUserUser")
  reviewedWorkspaceRequests WorkspaceJoinRequest[]     @relation("WorkspaceJoinRequestReviewedBy")
  sentWorkspaceInvites      WorkspaceInvite[]          @relation("WorkspaceInviteInvitedBy")
  acceptedWorkspaceInvites  WorkspaceInvite[]          @relation("WorkspaceInviteAcceptedBy")
  lastWorkspace             Workspace?                 @relation("UserLastWorkspace", fields: [lastWorkspaceId], references: [id], onDelete: SetNull)

  @@unique(fields: [username])
  @@unique(fields: [email])
  @@index(fields: [deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [deletedAt, name, id])
  @@index(fields: [status, deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [roleId, deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [countryId, deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [signUpAt(sort: Desc)])
  @@index(fields: [deletedAt, signUpAt(sort: Desc)])
  @@index(fields: [deletedAt, passwordAttempt])
  @@index(fields: [deletedAt, passwordLockedUntil])
  @@index(fields: [deletedAt, lastLoginAt(sort: Desc)])
  @@map("users")
}

model Verification {
  id             String                          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String                          @db.Uuid
  mobileNumberId String?                         @db.Uuid
  to             String
  type           EnumVerificationType
  action         EnumUserReauthenticationAction?
  token          String
  expiredAt      DateTime
  verifiedAt     DateTime?
  isUsed         Boolean                         @default(false)
  reference      String

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  user         User              @relation("UserVerifications", fields: [userId], references: [id], onDelete: Cascade)
  mobileNumber UserMobileNumber? @relation("UserMobileNumberVerification", fields: [mobileNumberId], references: [id], onDelete: Cascade)

  @@unique(fields: [reference])
  @@index(fields: [token])
  @@index(fields: [userId, type, createdAt(sort: Desc)])
  @@index(fields: [userId, type, action, createdAt(sort: Desc)])
  @@index(fields: [mobileNumberId])
  @@index(fields: [type, createdAt])
  @@index(fields: [expiredAt])
  @@map("verifications")
}

model PasswordHistory {
  id        String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String                  @db.Uuid
  password  String
  type      EnumPasswordHistoryType
  expiredAt DateTime

  user User @relation("UserPasswordHistories", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid

  @@index(fields: [userId, expiredAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [type, createdAt(sort: Desc)])
  @@index(fields: [expiredAt])
  @@map("password_histories")
}

model CommonPassword {
  id    String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  value String @unique

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid

  @@map("common_passwords")
}

model AuthSocialNonce {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  nonceHash String
  expiredAt DateTime

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid

  @@index(fields: [nonceHash])
  @@index(fields: [expiredAt])
  @@map("auth_social_nonces")
}

model ActivityLog {
  id          String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String                @db.Uuid
  workspaceId String?               @db.Uuid
  action      EnumActivityLogAction
  ipAddress   String?               @db.Inet
  userAgent   Json
  description String
  geoLocation Json?
  metadata    Json?

  // Deleting a user also deletes their activity logs, including the entries recorded in
  // workspaces the user acted on. We may want to retain those logs in the future.
  user      User       @relation("UserActivityLogs", fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation("WorkspaceActivityLogs", fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid

  @@index(fields: [userId, workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [action, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [createdAt(sort: Desc), workspaceId])
  @@map("activity_logs")
}

model UserPhoto {
  id           String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String                 @unique @db.Uuid
  bucket       String
  key          String
  cdnUrl       String?
  completedUrl String
  mime         String
  extension    String
  access       EnumAwsS3Accessibility

  user User @relation("UserPhoto", fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_photos")
}

model Session {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String    @db.Uuid
  deviceOwnershipId String    @db.Uuid
  jtiDigest         String
  ipAddress         String?   @db.Inet
  userAgent         Json
  geoLocation       Json?
  expiredAt         DateTime
  lastActiveAt      DateTime  @default(now())
  revokedAt         DateTime?
  isRevoked         Boolean   @default(false)
  revokedById       String?   @db.Uuid

  revokedBy       User?           @relation("SessionRevokedByUser", fields: [revokedById], references: [id], onDelete: SetNull)
  user            User            @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)
  deviceOwnership DeviceOwnership @relation("DeviceOwnershipSessions", fields: [deviceOwnershipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@unique(fields: [userId, jtiDigest])
  @@index(fields: [userId, isRevoked, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [userId, isRevoked, expiredAt])
  @@index(fields: [deviceOwnershipId, isRevoked, expiredAt])
  @@index(fields: [isRevoked, expiredAt])
  @@index(fields: [expiredAt])
  @@index(fields: [createdAt(sort: Desc)])
  @@map("sessions")
}

model Device {
  id           String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fingerprint  String
  name         String?
  platform     EnumDevicePlatform
  lastActiveAt DateTime           @default(now())

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  ownerships DeviceOwnership[] @relation("DeviceOwnershipDevice")

  @@unique(fields: [fingerprint])
  @@index(fields: [createdAt(sort: Desc)])
  @@map("devices")
}

model DeviceOwnership {
  id                   String                          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deviceId             String                          @db.Uuid
  userId               String                          @db.Uuid
  revokedAt            DateTime?
  isRevoked            Boolean                         @default(false)
  revokedById          String?                         @db.Uuid
  lastActiveAt         DateTime                        @default(now())
  notificationToken    String?
  notificationProvider EnumDeviceNotificationProvider?

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  revokedBy User?     @relation("DeviceOwnershipRevokedByUser", fields: [revokedById], references: [id], onDelete: SetNull)
  device    Device    @relation("DeviceOwnershipDevice", fields: [deviceId], references: [id], onDelete: Cascade)
  user      User      @relation("DeviceOwnershipUser", fields: [userId], references: [id], onDelete: Cascade)
  sessions  Session[] @relation("DeviceOwnershipSessions")

  @@unique(fields: [deviceId, userId])
  @@index(fields: [userId, isRevoked, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [userId, lastActiveAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [isRevoked, lastActiveAt])
  @@index(fields: [notificationToken, lastActiveAt])
  @@map("device_ownerships")
}

model Mfa {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String    @db.Uuid
  attempt     Int       @default(0)
  lockedUntil DateTime?

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  user        User            @relation("UserMfa", fields: [userId], references: [id], onDelete: Cascade)
  backupCodes MfaBackupCode[] @relation("MfaBackupCodes")

  @@unique(fields: [userId])
  @@map("mfas")
}

model MfaBackupCode {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  mfaId     String    @db.Uuid
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  mfa Mfa @relation("MfaBackupCodes", fields: [mfaId], references: [id], onDelete: Cascade)

  @@unique(fields: [mfaId, codeHash])
  @@index(fields: [mfaId, usedAt])
  @@map("mfa_backup_codes")
}

model MfaTotp {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String    @db.Uuid
  secret        String?
  pendingSecret String?
  confirmedAt   DateTime?
  lastUsedAt    DateTime?
  lastUsedStep  Int?

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  user User @relation("UserMfaTotp", fields: [userId], references: [id], onDelete: Cascade)

  @@unique(fields: [userId])
  @@map("mfa_totps")
}

model MfaPasskey {
  id           String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String                   @db.Uuid
  credentialId String
  publicKey    String
  counter      Int
  transports   String[]                 @default([])
  deviceType   EnumMfaPasskeyDeviceType
  backedUp     Boolean
  name         String
  lastUsedAt   DateTime?

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  user User @relation("UserMfaPasskeys", fields: [userId], references: [id], onDelete: Cascade)

  @@unique(fields: [credentialId])
  @@index(fields: [userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("mfa_passkeys")
}

model MfaChallenge {
  id                String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String?                 @db.Uuid
  purpose           EnumMfaChallengePurpose
  tokenHash         String
  webAuthnChallenge String?
  device            Json?
  loginFrom         EnumUserLoginFrom?
  loginWith         EnumUserLoginWith?
  expiredAt         DateTime
  consumedAt        DateTime?

  user User? @relation("UserMfaChallenges", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@unique(fields: [tokenHash])
  @@index(fields: [expiredAt])
  @@map("mfa_challenges")
}

model TermPolicy {
  id          String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type        EnumTermPolicyType
  contents    TermPolicyContent[]
  version     Int                  @default(1)
  status      EnumTermPolicyStatus @default(draft)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  userAcceptances TermPolicyUserAcceptance[] @relation("TermPolicyUserAcceptanceTermPolicy")

  @@unique(fields: [type, version])
  @@index(fields: [type, status, version(sort: Desc)])
  @@map("term_policies")
}

model TermPolicyContent {
  id           String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  termPolicyId String                 @db.Uuid
  language     String
  bucket       String
  key          String
  cdnUrl       String?
  completedUrl String
  mime         String
  extension    String
  access       EnumAwsS3Accessibility
  size         Int

  termPolicy TermPolicy @relation(fields: [termPolicyId], references: [id], onDelete: Cascade)

  @@unique(fields: [termPolicyId, language])
  @@map("term_policy_contents")
}

model TermPolicyRecipient {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  termPolicyId   String    @db.Uuid
  userId         String    @db.Uuid
  notificationId String    @db.Uuid
  batchId        String    @db.Uuid
  sentAt         DateTime?
  claimedAt      DateTime?
  claimNonce     String?   @db.Uuid

  user User @relation("UserTermPolicyRecipients", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@unique(fields: [termPolicyId, userId])
  @@index(fields: [termPolicyId, batchId, userId])
  @@index(fields: [userId])
  @@map("term_policy_recipients")
}

model TermPolicyUserAcceptance {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String   @db.Uuid
  termPolicyId String   @db.Uuid
  acceptedAt   DateTime @default(now())

  user       User       @relation("TermPolicyUserAcceptanceUser", fields: [userId], references: [id], onDelete: Cascade)
  termPolicy TermPolicy @relation("TermPolicyUserAcceptanceTermPolicy", fields: [termPolicyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid

  @@unique(fields: [userId, termPolicyId])
  @@index(fields: [termPolicyId, acceptedAt(sort: Desc)])
  @@index(fields: [userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [acceptedAt])
  @@map("term_policy_user_acceptances")
}

model FeatureFlag {
  id             String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key            String
  description    String
  isEnable       Boolean @default(true)
  rolloutPercent Int     @default(100)
  metadata       Json?

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  targetUsers FeatureFlagUser[] @relation("FeatureFlagUserFeatureFlag")

  @@unique(fields: [key])
  @@map("feature_flags")
}

model FeatureFlagUser {
  id            String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  featureFlagId String @db.Uuid
  userId        String @db.Uuid

  featureFlag FeatureFlag @relation("FeatureFlagUserFeatureFlag", fields: [featureFlagId], references: [id], onDelete: Cascade)
  user        User        @relation("FeatureFlagUserUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique(fields: [featureFlagId, userId])
  @@index(fields: [userId])
  @@map("feature_flag_users")
}

model ForgotPassword {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @db.Uuid
  to        String
  token     String
  expiredAt DateTime
  resetAt   DateTime?
  isUsed    Boolean   @default(false)
  reference String

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  user User @relation("UserForgotPassword", fields: [userId], references: [id], onDelete: Cascade)

  @@unique(fields: [reference])
  @@index(fields: [token])
  @@index(fields: [userId, createdAt(sort: Desc)])
  @@index(fields: [createdAt(sort: Desc)])
  @@index(fields: [expiredAt])
  @@map("forgot_passwords")
}

model Notification {
  id       String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId   String                   @db.Uuid
  type     EnumNotificationType
  priority EnumNotificationPriority @default(normal)
  title    String
  body     String
  metadata Json?
  isRead   Boolean                  @default(false)
  readAt   DateTime?

  user       User                   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[] @relation("NotificationDeliveries")

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@index(fields: [userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [userId, isRead, createdAt(sort: Desc), id(sort: Desc)])
  @@map("notifications")
}

model NotificationDelivery {
  id             String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  notificationId String                  @db.Uuid
  channel        EnumNotificationChannel
  sentAt         DateTime?
  processedAt    DateTime?
  failureTokens  String[]                @default([])

  notification Notification @relation("NotificationDeliveries", fields: [notificationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@unique(fields: [notificationId, channel])
  @@map("notification_deliveries")
}

model NotificationUserSetting {
  id       String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId   String                  @db.Uuid
  channel  EnumNotificationChannel
  type     EnumNotificationType
  isActive Boolean                 @default(true)

  user User @relation("UserNotificationSettings", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@unique(fields: [userId, channel, type])
  @@map("notification_user_settings")
}

model Workspace {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  slug        String
  description String?
  isPublic    Boolean @default(false)

  members      WorkspaceMember[]
  invites      WorkspaceInvite[]
  joinRequests WorkspaceJoinRequest[]
  projects     Project[]
  activityLogs ActivityLog[]          @relation("WorkspaceActivityLogs")
  lastUsers    User[]                 @relation("UserLastWorkspace")

  createdAt DateTime  @default(now())
  createdBy String?   @db.Uuid
  updatedAt DateTime  @updatedAt
  updatedBy String?   @db.Uuid
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  @@unique(fields: [slug])
  @@index(fields: [isPublic, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [name, id])
  @@index(fields: [createdAt(sort: Desc), id(sort: Desc)])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  roleId      String   @db.Uuid
  joinedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("UserWorkspaceMembers", fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation("WorkspaceMemberRole", fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@unique(fields: [workspaceId, userId])
  @@index(fields: [userId, roleId])
  @@index(fields: [workspaceId, roleId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [workspaceId, joinedAt, id])
  @@map("workspace_members")
}

model WorkspaceInvite {
  id               String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId      String                    @db.Uuid
  email            String
  workspaceRoleId  String                    @db.Uuid
  projectId        String?                   @db.Uuid
  projectRoleId    String?                   @db.Uuid
  token            String
  reference        String
  expiredAt        DateTime
  status           EnumWorkspaceInviteStatus @default(pending)
  invitedByUserId  String                    @db.Uuid
  acceptedAt       DateTime?
  acceptedByUserId String?                   @db.Uuid
  nonce            String

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspaceRole Role      @relation("WorkspaceInviteWorkspaceRole", fields: [workspaceRoleId], references: [id], onDelete: Cascade)
  projectRole   Role?     @relation("WorkspaceInviteProjectRole", fields: [projectRoleId], references: [id], onDelete: SetNull)
  invitedBy     User      @relation("WorkspaceInviteInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy    User?     @relation("WorkspaceInviteAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@unique(fields: [token])
  @@unique(fields: [reference])
  @@unique(fields: [nonce])
  @@index(fields: [workspaceId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [email, status])
  @@index(fields: [status, expiredAt])
  @@index(fields: [projectId])
  @@map("workspace_invites")
}

model WorkspaceJoinRequest {
  id               String                         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId      String                         @db.Uuid
  userId           String                         @db.Uuid
  status           EnumWorkspaceJoinRequestStatus @default(pending)
  message          String?
  rejectReasonCode EnumWorkspaceJoinRejectReason?
  reviewedByUserId String?                        @db.Uuid
  reviewedAt       DateTime?
  expiredAt        DateTime
  nonce            String

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User      @relation("UserWorkspaceJoinRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?     @relation("WorkspaceJoinRequestReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@unique(fields: [nonce])
  @@index(fields: [workspaceId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [userId, status])
  @@index(fields: [status, expiredAt])
  @@map("workspace_join_requests")
}

model Project {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String  @db.Uuid
  name        String
  slug        String
  description String?

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   ProjectMember[]
  invites   WorkspaceInvite[]

  createdAt DateTime  @default(now())
  createdBy String?   @db.Uuid
  updatedAt DateTime  @updatedAt
  updatedBy String?   @db.Uuid
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  @@unique(fields: [workspaceId, slug])
  @@index(fields: [workspaceId, deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [createdAt(sort: Desc), id(sort: Desc)])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId String   @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("UserProjectMembers", fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation("ProjectMemberRole", fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@unique(fields: [projectId, userId])
  @@index(fields: [userId])
  @@index(fields: [projectId, roleId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [projectId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [projectId, joinedAt, id])
  @@map("project_members")
}

model Outbox {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  queue          String
  name           String
  data           Json
  priority       Int
  idempotencyKey String
  status         EnumOutboxStatus
  attempts       Int              @default(0)
  lastError      String?
  enqueuedAt     DateTime?
  sweptAt        DateTime?
  completedAt    DateTime?
  failedAt       DateTime?

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@unique(fields: [queue, name, idempotencyKey])
  @@index(fields: [status, sweptAt, createdAt])
  @@index(fields: [status, sweptAt, enqueuedAt])
  @@map("outboxes")
}

