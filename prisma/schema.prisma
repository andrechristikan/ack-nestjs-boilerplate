datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma-client"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

model ApiKey {
  id       String         @id @default(auto()) @map("_id") @db.ObjectId
  type     EnumApiKeyType @default(default)
  name     String
  key      String
  hash     String
  isActive Boolean        @default(true)
  startAt  DateTime?
  endAt    DateTime?

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  @@unique(fields: [key])
  @@unique(fields: [hash])
  @@index(fields: [isActive, type, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [name, id])
  @@map("ApiKeys")
}

model Role {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  type        EnumRoleType @default(user)
  isImmutable Boolean      @default(false)

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  policies Policy[] @relation("RolePolicy")
  users    User[]   @relation("UserRole")

  @@unique(fields: [name])
  @@index(fields: [type, createdAt(sort: Desc), id(sort: Desc)])
  @@map("Roles")
}

model Policy {
  id      String             @id @default(auto()) @map("_id") @db.ObjectId
  roleId  String             @db.ObjectId
  subject EnumPolicySubject
  action  EnumPolicyAction[]

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  role Role @relation("RolePolicy", fields: [roleId], references: [id], onDelete: Cascade)

  @@unique(fields: [roleId, subject])
  @@map("Policies")
}

model Country {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  alpha2Code String
  alpha3Code String
  phoneCode  String[]
  continent  String
  timezone   String

  mobileNumbers UserMobileNumber[] @relation("UserMobileNumberCountry")
  users         User[]             @relation("UserCountry")

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  @@unique(fields: [alpha2Code])
  @@unique(fields: [alpha3Code])
  @@index(fields: [name])
  @@map("Countries")
}

model UserMobileNumber {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  countryId  String    @db.ObjectId
  phoneCode  String
  number     String
  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  country       Country        @relation("UserMobileNumberCountry", fields: [countryId], references: [id])
  user          User           @relation("UserMobileNumberUser", fields: [userId], references: [id])
  verifications Verification[] @relation("UserMobileNumberVerification")

  @@unique(fields: [userId, countryId, phoneCode, number])
  @@map("UserMobileNumbers")
}

model UserSocial {
  id       String            @id @default(auto()) @map("_id") @db.ObjectId
  userId   String            @db.ObjectId
  provider EnumUserLoginWith
  subject  String

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId

  user User @relation("UserSocialUser", fields: [userId], references: [id])

  @@unique(fields: [provider, subject])
  @@unique(fields: [userId, provider])
  @@map("UserSocials")
}

model User {
  id                     String             @id @default(auto()) @map("_id") @db.ObjectId
  name                   String?
  username               String
  isVerified             Boolean            @default(false)
  verifiedAt             DateTime?
  email                  String
  roleId                 String             @db.ObjectId
  password               String?
  passwordExpired        DateTime?
  passwordCreated        DateTime?
  passwordAttempt        Int                @default(0)
  passwordLockedUntil    DateTime?
  signUpAt               DateTime           @default(now())
  signUpFrom             EnumUserSignUpFrom
  signUpWith             EnumUserSignUpWith
  status                 EnumUserStatus     @default(active)
  gender                 EnumUserGender?
  countryId              String             @db.ObjectId
  lastLoginAt            DateTime?
  lastIPAddress          String?
  lastLoginFrom          EnumUserLoginFrom?
  lastLoginWith          EnumUserLoginWith?
  lastWorkspaceId        String?            @db.ObjectId
  lastWorkspaceChangedAt DateTime?
  photo                  UserPhoto?

  createdAt DateTime  @default(now())
  createdBy String?   @db.ObjectId
  updatedAt DateTime  @updatedAt
  updatedBy String?   @db.ObjectId
  deletedAt DateTime?
  deletedBy String?   @db.ObjectId

  mobileNumbers           UserMobileNumber[]         @relation("UserMobileNumberUser")
  socials                 UserSocial[]               @relation("UserSocialUser")
  verifications           Verification[]             @relation("UserVerifications")
  passwordHistories       PasswordHistory[]          @relation("UserPasswordHistories")
  activityLogs            ActivityLog[]              @relation("UserActivityLogs")
  role                    Role                       @relation("UserRole", fields: [roleId], references: [id])
  country                 Country                    @relation("UserCountry", fields: [countryId], references: [id])
  sessions                Session[]                  @relation("UserSessions")
  acceptances             TermPolicyUserAcceptance[] @relation("TermPolicyUserAcceptanceUser")
  forgotPasswords         ForgotPassword[]           @relation("UserForgotPassword")
  mfa                     Mfa?                       @relation("UserMfa")
  mfaTotp                 MfaTotp?                   @relation("UserMfaTotp")
  mfaPasskeys             MfaPasskey[]               @relation("UserMfaPasskeys")
  mfaChallenges           MfaChallenge[]             @relation("UserMfaChallenges")
  notifications           Notification[]             @relation("UserNotifications")
  notificationSettings    NotificationUserSetting[]  @relation("UserNotificationSettings")
  deviceOwnerships        DeviceOwnership[]          @relation("DeviceOwnershipUser")
  revokedSessions         Session[]                  @relation("SessionRevokedByUser")
  revokedDeviceOwnerships DeviceOwnership[]          @relation("DeviceOwnershipRevokedByUser")
  workspaceMembers        WorkspaceMember[]          @relation("UserWorkspaceMembers")
  workspaceJoinRequests   WorkspaceJoinRequest[]     @relation("UserWorkspaceJoinRequests")
  projectMembers          ProjectMember[]            @relation("UserProjectMembers")
  termPolicyRecipients    TermPolicyRecipient[]      @relation("UserTermPolicyRecipients")

  @@unique(fields: [username])
  @@unique(fields: [email])
  @@index(fields: [deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [deletedAt, name, id])
  @@index(fields: [status, deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [roleId, deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [countryId, deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [signUpAt(sort: Desc)])
  @@index(fields: [deletedAt, signUpAt(sort: Desc)])
  @@index(fields: [deletedAt, passwordAttempt])
  @@index(fields: [deletedAt, passwordLockedUntil])
  @@index(fields: [deletedAt, lastLoginAt(sort: Desc)])
  @@map("Users")
}

model Verification {
  id             String                          @id @default(auto()) @map("_id") @db.ObjectId
  userId         String                          @db.ObjectId
  mobileNumberId String?                         @db.ObjectId
  to             String
  type           EnumVerificationType
  action         EnumUserReauthenticationAction?
  token          String
  expiredAt      DateTime
  verifiedAt     DateTime?
  isUsed         Boolean                         @default(false)
  reference      String

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  user         User              @relation("UserVerifications", fields: [userId], references: [id])
  mobileNumber UserMobileNumber? @relation("UserMobileNumberVerification", fields: [mobileNumberId], references: [id])

  @@unique(fields: [reference])
  @@index(fields: [token])
  @@index(fields: [userId, type, createdAt(sort: Desc)])
  @@index(fields: [userId, type, action, createdAt(sort: Desc)])
  @@index(fields: [mobileNumberId])
  @@index(fields: [type, createdAt])
  @@map("Verifications")
}

model PasswordHistory {
  id        String                  @id @default(auto()) @map("_id") @db.ObjectId
  userId    String                  @db.ObjectId
  password  String
  type      EnumPasswordHistoryType
  expiredAt DateTime

  user User @relation("UserPasswordHistories", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId

  @@index(fields: [userId, expiredAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [type, createdAt(sort: Desc)])
  @@map("PasswordHistories")
}

model CommonPassword {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  value String @unique

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId

  @@map("CommonPasswords")
}

model AuthSocialNonce {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nonceHash String
  expiredAt DateTime

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId

  @@index(fields: [nonceHash])
  @@index(fields: [expiredAt])
  @@map("AuthSocialNonces")
}

model ActivityLog {
  id          String                @id @default(auto()) @map("_id") @db.ObjectId
  userId      String                @db.ObjectId
  workspaceId String?               @db.ObjectId
  action      EnumActivityLogAction
  ipAddress   String?
  userAgent   UserAgent
  description String
  geoLocation GeoLocation?
  metadata    Json?

  user      User       @relation("UserActivityLogs", fields: [userId], references: [id])
  workspace Workspace? @relation("WorkspaceActivityLogs", fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId

  @@index(fields: [userId, workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [action, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [createdAt(sort: Desc), workspaceId])
  @@map("ActivityLogs")
}

model Session {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  userId            String       @db.ObjectId
  deviceOwnershipId String       @db.ObjectId
  jtiDigest         String
  ipAddress         String?
  userAgent         UserAgent
  geoLocation       GeoLocation?
  expiredAt         DateTime
  lastActiveAt      DateTime     @default(now())
  revokedAt         DateTime?
  isRevoked         Boolean      @default(false)
  revokedById       String?      @db.ObjectId

  revokedBy       User?           @relation("SessionRevokedByUser", fields: [revokedById], references: [id])
  user            User            @relation("UserSessions", fields: [userId], references: [id])
  deviceOwnership DeviceOwnership @relation("DeviceOwnershipSessions", fields: [deviceOwnershipId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  @@unique(fields: [userId, jtiDigest])
  @@index(fields: [userId, isRevoked, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [userId, isRevoked, expiredAt])
  @@index(fields: [deviceOwnershipId, isRevoked, expiredAt])
  @@index(fields: [createdAt(sort: Desc)])
  @@map("Sessions")
}

model Device {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  fingerprint  String
  name         String?
  platform     EnumDevicePlatform
  lastActiveAt DateTime           @default(now())

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  ownerships DeviceOwnership[] @relation("DeviceOwnershipDevice")

  @@unique(fields: [fingerprint])
  @@index(fields: [createdAt(sort: Desc)])
  @@map("Devices")
}

model DeviceOwnership {
  id                   String                          @id @default(auto()) @map("_id") @db.ObjectId
  deviceId             String                          @db.ObjectId
  userId               String                          @db.ObjectId
  revokedAt            DateTime?
  isRevoked            Boolean                         @default(false)
  revokedById          String?                         @db.ObjectId
  lastActiveAt         DateTime                        @default(now())
  notificationToken    String?
  notificationProvider EnumDeviceNotificationProvider?

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  revokedBy User?     @relation("DeviceOwnershipRevokedByUser", fields: [revokedById], references: [id])
  device    Device    @relation("DeviceOwnershipDevice", fields: [deviceId], references: [id])
  user      User      @relation("DeviceOwnershipUser", fields: [userId], references: [id])
  sessions  Session[] @relation("DeviceOwnershipSessions")

  @@unique(fields: [deviceId, userId])
  @@index(fields: [userId, isRevoked, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [userId, lastActiveAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [isRevoked, lastActiveAt])
  @@index(fields: [notificationToken, lastActiveAt])
  @@map("DeviceOwnerships")
}

model Mfa {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  backupCodes String[]  @default([])
  attempt     Int       @default(0)
  lockedUntil DateTime?

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  user User @relation("UserMfa", fields: [userId], references: [id])

  @@unique(fields: [userId])
  @@map("Mfas")
}

model MfaTotp {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  secret        String?
  pendingSecret String?
  confirmedAt   DateTime?
  lastUsedAt    DateTime?
  lastUsedStep  Int?

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  user User @relation("UserMfaTotp", fields: [userId], references: [id])

  @@unique(fields: [userId])
  @@map("MfaTotps")
}

model MfaPasskey {
  id           String                   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String                   @db.ObjectId
  credentialId String
  publicKey    String
  counter      Int
  transports   String[]                 @default([])
  deviceType   EnumMfaPasskeyDeviceType
  backedUp     Boolean
  name         String
  lastUsedAt   DateTime?

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  user User @relation("UserMfaPasskeys", fields: [userId], references: [id])

  @@unique(fields: [credentialId])
  @@index(fields: [userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("MfaPasskeys")
}

model MfaChallenge {
  id                String                  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String?                 @db.ObjectId
  purpose           EnumMfaChallengePurpose
  tokenHash         String
  webAuthnChallenge String?
  device            MfaChallengeDevice?
  loginFrom         EnumUserLoginFrom?
  loginWith         EnumUserLoginWith?
  expiredAt         DateTime
  consumedAt        DateTime?

  user User? @relation("UserMfaChallenges", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  @@unique(fields: [tokenHash])
  @@map("MfaChallenges")
}

model TermPolicy {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  type        EnumTermPolicyType
  contents    TermPolicyContent[]
  version     Int                  @default(1)
  status      EnumTermPolicyStatus @default(draft)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  userAcceptances TermPolicyUserAcceptance[] @relation("TermPolicyUserAcceptanceTermPolicy")

  @@unique(fields: [type, version])
  @@index(fields: [type, status, version(sort: Desc)])
  @@map("TermPolicies")
}

model TermPolicyRecipient {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  termPolicyId   String    @db.ObjectId
  userId         String    @db.ObjectId
  notificationId String    @db.ObjectId
  batchId        String    @db.ObjectId
  sentAt         DateTime?
  claimedAt      DateTime?
  claimNonce     String?   @db.ObjectId

  user User @relation("UserTermPolicyRecipients", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  @@unique(fields: [termPolicyId, userId])
  @@index(fields: [termPolicyId, batchId, userId])
  @@index(fields: [userId])
  @@map("TermPolicyRecipients")
}

model TermPolicyUserAcceptance {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  termPolicyId String   @db.ObjectId
  acceptedAt   DateTime @default(now())

  user       User       @relation("TermPolicyUserAcceptanceUser", fields: [userId], references: [id])
  termPolicy TermPolicy @relation("TermPolicyUserAcceptanceTermPolicy", fields: [termPolicyId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId

  @@unique(fields: [userId, termPolicyId])
  @@index(fields: [termPolicyId, acceptedAt(sort: Desc)])
  @@index(fields: [userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [acceptedAt])
  @@map("TermPolicyUserAcceptances")
}

model FeatureFlag {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  key            String
  description    String
  isEnable       Boolean  @default(true)
  rolloutPercent Int      @default(100)
  targetUserIds  String[] @default([]) @db.ObjectId
  metadata       Json?

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  @@unique(fields: [key])
  @@map("FeatureFlags")
}

model ForgotPassword {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  to        String
  token     String
  expiredAt DateTime
  resetAt   DateTime?
  isUsed    Boolean   @default(false)
  reference String

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  user User @relation("UserForgotPassword", fields: [userId], references: [id])

  @@unique(fields: [reference])
  @@index(fields: [token])
  @@index(fields: [userId, createdAt(sort: Desc)])
  @@index(fields: [createdAt(sort: Desc)])
  @@map("ForgotPasswords")
}

model Notification {
  id       String                   @id @default(auto()) @map("_id") @db.ObjectId
  userId   String                   @db.ObjectId
  type     EnumNotificationType
  priority EnumNotificationPriority @default(normal)
  title    String
  body     String
  metadata Json?
  isRead   Boolean                  @default(false)
  readAt   DateTime?

  user       User                   @relation("UserNotifications", fields: [userId], references: [id])
  deliveries NotificationDelivery[] @relation("NotificationDeliveries")

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  @@index(fields: [userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [userId, isRead, createdAt(sort: Desc), id(sort: Desc)])
  @@map("Notifications")
}

model NotificationDelivery {
  id             String                  @id @default(auto()) @map("_id") @db.ObjectId
  notificationId String                  @db.ObjectId
  channel        EnumNotificationChannel
  sentAt         DateTime?
  processedAt    DateTime?
  failureTokens  String[]                @default([])

  notification Notification @relation("NotificationDeliveries", fields: [notificationId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  @@unique(fields: [notificationId, channel])
  @@map("NotificationDeliveries")
}

model NotificationUserSetting {
  id       String                  @id @default(auto()) @map("_id") @db.ObjectId
  userId   String                  @db.ObjectId
  channel  EnumNotificationChannel
  type     EnumNotificationType
  isActive Boolean                 @default(true)

  user User @relation("UserNotificationSettings", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  @@unique(fields: [userId, channel, type])
  @@map("NotificationUserSettings")
}

model Workspace {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String
  description String?
  isPublic    Boolean @default(false)

  members      WorkspaceMember[]
  invites      WorkspaceInvite[]
  joinRequests WorkspaceJoinRequest[]
  projects     Project[]
  activityLogs ActivityLog[]          @relation("WorkspaceActivityLogs")

  createdAt DateTime  @default(now())
  createdBy String?   @db.ObjectId
  updatedAt DateTime  @updatedAt
  updatedBy String?   @db.ObjectId
  deletedAt DateTime?
  deletedBy String?   @db.ObjectId

  @@unique(fields: [slug])
  @@index(fields: [isPublic, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [name, id])
  @@index(fields: [createdAt(sort: Desc), id(sort: Desc)])
  @@map("Workspaces")
}

model WorkspaceMember {
  id          String                  @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String                  @db.ObjectId
  userId      String                  @db.ObjectId
  role        EnumWorkspaceMemberRole
  joinedAt    DateTime                @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation("UserWorkspaceMembers", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  @@unique(fields: [workspaceId, userId])
  @@index(fields: [userId, role])
  @@index(fields: [workspaceId, role, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [workspaceId, joinedAt, id])
  @@map("WorkspaceMembers")
}

model WorkspaceInvite {
  id               String                    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId      String                    @db.ObjectId
  email            String
  workspaceRole    EnumWorkspaceMemberRole
  projectId        String?                   @db.ObjectId
  projectRole      EnumProjectMemberRole?
  token            String
  reference        String
  expiredAt        DateTime
  status           EnumWorkspaceInviteStatus @default(pending)
  invitedByUserId  String                    @db.ObjectId
  acceptedAt       DateTime?
  acceptedByUserId String?                   @db.ObjectId
  nonce            String

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  project   Project?  @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  @@unique(fields: [token])
  @@unique(fields: [reference])
  @@unique(fields: [nonce])
  @@index(fields: [workspaceId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [email, status])
  @@index(fields: [status, expiredAt])
  @@index(fields: [projectId])
  @@map("WorkspaceInvites")
}

model WorkspaceJoinRequest {
  id               String                         @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId      String                         @db.ObjectId
  userId           String                         @db.ObjectId
  status           EnumWorkspaceJoinRequestStatus @default(pending)
  message          String?
  rejectReasonCode EnumWorkspaceJoinRejectReason?
  reviewedByUserId String?                        @db.ObjectId
  reviewedAt       DateTime?
  expiredAt        DateTime
  nonce            String

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation("UserWorkspaceJoinRequests", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  @@unique(fields: [nonce])
  @@index(fields: [workspaceId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [userId, status])
  @@index(fields: [status, expiredAt])
  @@map("WorkspaceJoinRequests")
}

model Project {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String  @db.ObjectId
  name        String
  slug        String
  description String?

  workspace Workspace         @relation(fields: [workspaceId], references: [id])
  members   ProjectMember[]
  invites   WorkspaceInvite[]

  createdAt DateTime  @default(now())
  createdBy String?   @db.ObjectId
  updatedAt DateTime  @updatedAt
  updatedBy String?   @db.ObjectId
  deletedAt DateTime?
  deletedBy String?   @db.ObjectId

  @@unique(fields: [workspaceId, slug])
  @@index(fields: [workspaceId, deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [createdAt(sort: Desc), id(sort: Desc)])
  @@map("Projects")
}

model ProjectMember {
  id        String                @id @default(auto()) @map("_id") @db.ObjectId
  projectId String                @db.ObjectId
  userId    String                @db.ObjectId
  role      EnumProjectMemberRole
  joinedAt  DateTime              @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation("UserProjectMembers", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  @@unique(fields: [projectId, userId])
  @@index(fields: [userId])
  @@index(fields: [projectId, role, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [projectId, createdAt(sort: Desc), id(sort: Desc)])
  @@index(fields: [projectId, joinedAt, id])
  @@map("ProjectMembers")
}

model Outbox {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  queue          String
  name           String
  data           Json
  priority       Int
  idempotencyKey String
  status         EnumOutboxStatus
  attempts       Int              @default(0)
  lastError      String?
  enqueuedAt     DateTime?
  sweptAt        DateTime?
  completedAt    DateTime?
  failedAt       DateTime?

  createdAt DateTime @default(now())
  createdBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId

  @@unique(fields: [queue, name, idempotencyKey])
  @@index(fields: [status, sweptAt, createdAt])
  @@index(fields: [status, sweptAt, enqueuedAt])
  @@map("Outboxes")
}

