{
    "name": "ack-nestjs-boilerplate",
    "version": "9.0.0",
    "description": "Ack NestJs Boilerplate",
    "repository": {
        "type": "git",
        "url": "https://github.com/andrechristikan/ack-nestjs-boilerplate.git"
    },
    "author": {
        "name": "andrechristikan",
        "email": "andrechristikan@gmail.com"
    },
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "prebuild": "rimraf dist",
        "prepare": "husky",
        "clean": "rimraf dist && rimraf node_modules && pnpm store prune",
        "generate:secret": "node scripts/generate-secret.ts all",
        "generate:secret:jwt": "node scripts/generate-secret.ts jwt",
        "generate:secret:encryption": "node scripts/generate-secret.ts encryption",
        "generate:package": "node scripts/generate-package.ts",
        "generate": "pnpm db:generate && pnpm generate:package",
        "format": "prettier --write '{src,test}/**/*.{ts,json,yml,yaml}' && prettier --write '*.{ts,json,yml,yaml,mjs}'",
        "deadcode": "knip",
        "spell": "cspell lint --config cspell.json '{src,test}/**/*.ts' --color --gitignore --no-must-find-files --no-summary --no-progress || true",
        "typecheck": "tsc --noEmit",
        "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput",
        "build": "nest build application --config nest-cli.json && pnpm typecheck",
        "start": "nest start application --config nest-cli.json --exec \"node --import ./dist/instrument.js\"",
        "start:dev": "concurrently -n \"Nest,TypeCheck\" -c \"green,yellow\" \"nest start application --watch --config nest-cli.json --exec 'node --import ./dist/instrument.js'\" \"pnpm typecheck:watch\"",
        "start:prod": "node --import ./dist/instrument.js dist/main.js",
        "lint": "eslint",
        "lint:staged": "lint-staged",
        "lint:fix": "eslint --fix",
        "test": "TZ=UTC vitest run --passWithNoTests",
        "test:cov": "TZ=UTC vitest run --passWithNoTests --coverage",
        "test:e2e": "TZ=UTC vitest run --config vitest.e2e.config.ts",
        "test:e2e:env:up": "docker compose -f docker-compose.e2e.yml -p ack-nestjs-e2e up -d",
        "test:e2e:env:down": "docker compose -f docker-compose.e2e.yml -p ack-nestjs-e2e down --volumes --remove-orphans",
        "test:e2e:db:reset": "sh -c 'set -a; . ./.env.e2e; set +a; prisma migrate reset --force --skip-seed && pnpm migration:seed'",
        "package:upgrade": "npx npm-check-updates -u",
        "package:check": "npx npm-check-updates -i",
        "migration": "nest build migration --config nest-cli.json && node --import ./dist/instrument.js dist/migration.js",
        "migration:seed": "nest build migration --config nest-cli.json && node --import ./dist/instrument.js dist/migration.js apiKey --type seed && node --import ./dist/instrument.js dist/migration.js country --type seed && node --import ./dist/instrument.js dist/migration.js featureFlag --type seed && node --import ./dist/instrument.js dist/migration.js role --type seed && node --import ./dist/instrument.js dist/migration.js policy --type seed && node --import ./dist/instrument.js dist/migration.js termPolicy --type seed && node --import ./dist/instrument.js dist/migration.js user --type seed && node --import ./dist/instrument.js dist/migration.js workspace --type seed",
        "migration:remove": "nest build migration --config nest-cli.json && node --import ./dist/instrument.js dist/migration.js workspace --type remove && node --import ./dist/instrument.js dist/migration.js user --type remove && node --import ./dist/instrument.js dist/migration.js apiKey --type remove && node --import ./dist/instrument.js dist/migration.js featureFlag --type remove && node --import ./dist/instrument.js dist/migration.js country --type remove && node --import ./dist/instrument.js dist/migration.js policy --type remove && node --import ./dist/instrument.js dist/migration.js role --type remove && node --import ./dist/instrument.js dist/migration.js termPolicy --type remove",
        "migration:fresh": "prisma migrate reset --force && pnpm run migration:seed",
        "db:migrate": "prisma migrate dev",
        "db:generate": "prisma generate",
        "db:studio": "prisma studio",
        "db:format": "prisma format",
        "vault:pull": "sh ci/vault/pull.sh"
    },
    "dependencies": {
        "@2toad/profanity": "^3.3.0",
        "@aws-sdk/client-s3": "^3.1136.0",
        "@aws-sdk/client-ses": "^3.1136.0",
        "@aws-sdk/s3-request-presigner": "^3.1136.0",
        "@casl/ability": "^7.0.1",
        "@faker-js/faker": "^10.6.0",
        "@keyv/redis": "^5.1.6",
        "@nestjs/bullmq": "^12.0.0",
        "@nestjs/cache-manager": "^12.0.0",
        "@nestjs/common": "^12.0.3",
        "@nestjs/config": "^12.0.0",
        "@nestjs/core": "^12.0.3",
        "@nestjs/jwt": "^12.0.2",
        "@nestjs/passport": "^12.0.0",
        "@nestjs/platform-express": "^12.0.3",
        "@nestjs/swagger": "^12.0.1",
        "@nestjs/terminus": "^12.1.0",
        "@nestjs/throttler": "^6.7.0",
        "@prisma/client": "^6.19.0",
        "@sentry/nestjs": "^10.75.0",
        "@sentry/profiling-node": "^10.75.0",
        "@smithy/types": "^4.18.0",
        "@supercharge/request-ip": "^1.2.0",
        "bcryptjs": "^3.0.3",
        "body-parser": "^2.3.0",
        "bullmq": "^6.3.8",
        "bytes": "^3.1.2",
        "cache-manager": "^7.2.9",
        "case": "^1.6.3",
        "compression": "^1.8.2",
        "cors": "^2.8.6",
        "dotenv": "^18.0.1",
        "file-type": "^22.1.1",
        "firebase-admin": "^14.4.0",
        "flat": "^6.0.1",
        "geoip-lite": "^2.0.3",
        "google-auth-library": "^11.1.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "jwks-rsa": "^4.1.0",
        "keyv": "^5.6.0",
        "lodash-es": "^4.18.1",
        "luxon": "^3.7.2",
        "mime": "^4.1.0",
        "ms": "^2.1.3",
        "nest-commander": "^3.21.0",
        "nestjs-cls": "^6.3.0",
        "nestjs-i18n": "^10.8.5",
        "nestjs-pino": "^5.2.0",
        "otplib": "^13.5.0",
        "papaparse": "^5.7.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3",
        "pino-roll": "^4.0.0",
        "reflect-metadata": "^0.2.2",
        "response-time": "^2.3.4",
        "rxjs": "^7.8.2",
        "strip-ansi": "^7.2.0",
        "ua-parser-js": "^2.0.10",
        "uuid": "^14.0.2",
        "verify-apple-id-token": "^3.1.2",
        "zod": "^4.6.5",
        "zod-openapi": "^6.0.2"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@golevelup/ts-vitest": "^4.0.0",
        "@nestjs/cli": "^12.0.3",
        "@nestjs/schematics": "^12.0.3",
        "@nestjs/testing": "^12.0.3",
        "@standard-schema/spec": "^1.1.0",
        "@swc/cli": "^0.8.1",
        "@swc/core": "^1.16.2",
        "@types/body-parser": "^1.19.6",
        "@types/bytes": "^3.1.6",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/geoip-lite": "^1.4.4",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/lodash-es": "^4.17.12",
        "@types/luxon": "^3.7.5",
        "@types/ms": "^2.1.0",
        "@types/multer": "^2.2.0",
        "@types/node": "^26.6.2",
        "@types/papaparse": "^5.5.2",
        "@types/passport-jwt": "^4.0.1",
        "@types/response-time": "^2.3.9",
        "@types/supertest": "^7.2.1",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "@vitest/coverage-v8": "^5.0.1",
        "concurrently": "^10.0.5",
        "cspell": "^10.3.3",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-security": "^4.0.1",
        "husky": "^9.1.7",
        "knip": "^6.37.0",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.8",
        "prisma": "^6.19.0",
        "rimraf": "^6.1.3",
        "stop-only": "^3.4.4",
        "supertest": "^7.2.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "unplugin-swc": "^1.6.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.1",
        "vitest-mock-extended": "^5.1.1"
    },
    "lint-staged": {
        "**/*.ts": [
            "prettier --write",
            "eslint",
            "stop-only --file"
        ],
        "*.{json,yml,yaml}": [
            "prettier --write"
        ]
    },
    "packageManager": "pnpm@12.5.1",
    "engines": {
        "npm": "please-use-pnpm",
        "yarn": "please-use-pnpm",
        "node": ">= 24.15.0",
        "pnpm": ">= 10.25.0"
    }
}
