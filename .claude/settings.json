{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "attribution": { "commit": "", "pr": "", "sessionUrl": false },
    "plansDirectory": ".scratch/plans",
    "permissions": {
        "defaultMode": "acceptEdits",
        "allow": [
            "Read",
            "Edit",
            "Write",
            "Grep",
            "Glob",
            "WebFetch",
            "WebSearch",
            "Agent(general-purpose)",
            "Agent(Explore)",
            "Agent(coder)",
            "Agent(reviewer)",
            "Agent(writer)",
            "Agent(tester)",
            "Agent(debugger)",
            "Bash"
        ],
        "ask": [
            "Bash(git push:*)",
            "Bash(git clean:*)",
            "Bash(gh pr merge:*)",
            "Bash(gh pr create:*)",
            "Bash(gh pr edit:*)",
            "Bash(gh pr comment:*)",
            "Bash(gh issue create:*)",
            "Bash(gh api --method POST:*)",
            "Bash(gh release:*)",
            "Bash(pnpm publish:*)",
            "Bash(docker rm:*)",
            "Bash(docker volume rm:*)",
            "Bash(docker system prune:*)",
            "Bash(ssh:*)",
            "Bash(scp:*)",
            "Bash(rsync:*)",
            "Bash(pnpm vault:pull*)",
            "Bash(pnpm run vault:pull*)",
            "Bash(sh ci/vault/*)",
            "Edit(~/.claude/**)",
            "Bash(git commit:*)",
            "Bash(git add:*)",
            "Bash(git stash:*)",
            "Bash(git reset:*)",
            "Bash(git rm *)",
            "Bash(git mv *)",
            "Bash(git restore *)"
        ],
        "deny": [
            "Bash(pnpm db:migrate*)",
            "Bash(pnpm run db:migrate*)",
            "Bash(pnpm db:studio*)",
            "Bash(pnpm run db:studio*)",
            "Bash(pnpm migration*)",
            "Bash(pnpm run migration*)",
            "Bash(prisma db push*)",
            "Bash(prisma db execute*)",
            "Bash(prisma db seed*)",
            "Bash(prisma migrate*)",
            "Bash(prisma studio*)",
            "Bash(npx prisma db push*)",
            "Bash(npx prisma db execute*)",
            "Bash(npx prisma db seed*)",
            "Bash(npx prisma migrate*)",
            "Bash(npx prisma studio*)",
            "Bash(pnpm exec prisma db*)",
            "Bash(pnpm exec prisma migrate*)",
            "Bash(pnpm exec prisma studio*)",
            "Bash(pnpm dlx prisma db*)",
            "Bash(pnpm dlx prisma migrate*)",
            "Bash(pnpm dlx prisma studio*)",
            "Bash(pnpm prisma db*)",
            "Bash(pnpm prisma migrate*)",
            "Bash(pnpm prisma studio*)",
            "Bash(node dist/migration.js*)",
            "Bash(mongosh:*)",
            "Bash(mongo:*)",
            "Bash(redis-cli:*)",
            "Read(/.env)",
            "Read(/keys/**)",
            "Read(/generated/vault/**)",
            "Read(/.claude/settings.local.json)",
            "Monitor",
            "Workflow"
        ],
        "additionalDirectories": ["/tmp", "/private/tmp"]
    },
    "env": {
        "BASH_DEFAULT_TIMEOUT_MS": "600000"
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
                    }
                ]
            },
            {
                "matcher": "Write|Edit|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-write.sh"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
                        "timeout": 120
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify.sh",
                        "timeout": 600
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "startup|clear",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/roster.sh"
                    }
                ]
            }
        ]
    }
}
