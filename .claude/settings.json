        "additionalDirectories": ["/tmp", "/private/tmp"]
    },
    "enabledPlugins": {
        "superpowers@claude-plugins-official": true,
        "caveman@caveman": true
    },
    "claudeMdExcludes": ["**/.claude/rules/*.md"],
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deny-docs-superpowers.sh"
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deny-npm-yarn.sh"
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "startup|clear",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-skills.sh"
                    }
                ]
            }
        ]
    }
}
