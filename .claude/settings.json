{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "attribution": { "commit": "", "pr": "", "sessionUrl": false },
    "plansDirectory": ".scratch/plans",
    "statusLine": {
        "type": "command",
        "command": "npx -y ccstatusline@2.2.34",
        "padding": 0
    },
    "permissions": {
        "defaultMode": "acceptEdits",
        "allow": [
            "Read",
            "Edit",
            "Write",
            "Grep",
            "Glob",
            "WebFetch",
            "WebSearch",
            "Agent(general-purpose)",
            "Agent(Explore)",
            "Agent(researcher)",
            "Agent(coder)",
            "Agent(reviewer)",
            "Agent(reader)",
            "Agent(writer)",
            "Agent(tester)",
            "Agent(debugger)",
            "Agent(advisor)",
            "Agent(harness)",
            "Bash",
            "mcp__mongodb",
            "mcp__redis-cache",
            "mcp__redis-queue"
        ],
        "ask": [
            "Bash(git push:*)",
            "Bash(git clean:*)",
            "Bash(gh pr merge:*)",
            "Bash(gh pr create:*)",
            "Bash(gh pr edit:*)",
            "Bash(gh pr comment:*)",
            "Bash(gh issue create:*)",
            "Bash(gh api --method POST:*)",
            "Bash(gh release:*)",
            "Bash(pnpm publish:*)",
            "Bash(docker rm:*)",
            "Bash(docker volume rm:*)",
            "Bash(docker system prune:*)",
            "Bash(ssh:*)",
            "Bash(scp:*)",
            "Bash(rsync:*)",
            "Bash(pnpm vault:pull*)",
            "Bash(pnpm run vault:pull*)",
            "Bash(pnpm vault:push*)",
            "Bash(pnpm run vault:push*)",
            "Bash(sh ci/vault/*)",
            "Edit(~/.claude/**)",
            "Edit(/.claude/rules/discipline.md)",
            "Bash(git commit:*)",
            "Bash(git add:*)",
            "Bash(git stash:*)",
            "Bash(git reset:*)",
            "Bash(git rm *)",
            "Bash(git mv *)",
            "Bash(git restore *)",
            "Bash(git checkout:*)",
            "Bash(git switch:*)",
            "Bash(git merge:*)",
            "Bash(git rebase:*)",
            "Bash(git cherry-pick:*)",
            "Bash(git revert:*)",
            "Bash(git pull:*)",
            "Bash(git tag:*)",
            "Bash(pnpm add:*)",
            "Bash(pnpm remove:*)",
            "Bash(pnpm rm:*)",
            "Bash(pnpm up:*)",
            "Bash(pnpm update:*)",
            "Bash(pnpm upgrade:*)",
            "Bash(gh pr close:*)",
            "Bash(gh pr reopen:*)",
            "Bash(gh pr ready:*)",
            "Bash(gh pr review:*)",
            "Bash(gh issue edit:*)",
            "Bash(gh issue close:*)",
            "Bash(gh issue comment:*)",
            "Bash(gh issue delete:*)",
            "Bash(gh api -X:*)",
            "Bash(gh api --method PUT:*)",
            "Bash(gh api --method PATCH:*)",
            "Bash(gh api --method DELETE:*)",
            "Bash(gh repo:*)",
            "Bash(gh workflow run:*)",
            "Bash(gh run rerun:*)",
            "Bash(gh run cancel:*)",
            "Bash(gh secret:*)",
            "Bash(gh variable:*)",
            "Bash(gh label:*)"
        ],
        "deny": [
            "Bash(pnpm db:migrate*)",
            "Bash(pnpm run db:migrate*)",
            "Bash(pnpm db:studio*)",
            "Bash(pnpm run db:studio*)",
            "Bash(pnpm migration*)",
            "Bash(pnpm run migration*)",
            "Bash(prisma db push*)",
            "Bash(prisma db execute*)",
            "Bash(prisma db seed*)",
            "Bash(prisma migrate*)",
            "Bash(prisma studio*)",
            "Bash(npx prisma db push*)",
            "Bash(npx prisma db execute*)",
            "Bash(npx prisma db seed*)",
            "Bash(npx prisma migrate*)",
            "Bash(npx prisma studio*)",
            "Bash(pnpm exec prisma db*)",
            "Bash(pnpm exec prisma migrate*)",
            "Bash(pnpm exec prisma studio*)",
            "Bash(pnpm dlx prisma db*)",
            "Bash(pnpm dlx prisma migrate*)",
            "Bash(pnpm dlx prisma studio*)",
            "Bash(pnpm prisma db*)",
            "Bash(pnpm prisma migrate*)",
            "Bash(pnpm prisma studio*)",
            "Bash(node dist/migration.js*)",
            "Bash(mongosh:*)",
            "Bash(mongo:*)",
            "Bash(redis-cli:*)",
            "Read(/.env)",
            "Read(/keys/**)",
            "Read(/generated/vault/**)",
            "Read(/.env.harness)",
            "Read(/.env.docker)",
            "Edit(/.claude/settings.local.json)",
            "mcp__mongodb__connect",
            "mcp__redis-cache__json_set",
            "mcp__redis-cache__json_del",
            "mcp__redis-cache__lpush",
            "mcp__redis-cache__rpush",
            "mcp__redis-cache__lpop",
            "mcp__redis-cache__rpop",
            "mcp__redis-cache__lrem",
            "mcp__redis-cache__hset",
            "mcp__redis-cache__hdel",
            "mcp__redis-cache__set_vector_in_hash",
            "mcp__redis-cache__delete",
            "mcp__redis-cache__expire",
            "mcp__redis-cache__rename",
            "mcp__redis-cache__create_vector_index_hash",
            "mcp__redis-cache__publish",
            "mcp__redis-cache__subscribe",
            "mcp__redis-cache__psubscribe",
            "mcp__redis-cache__unsubscribe",
            "mcp__redis-cache__set",
            "mcp__redis-cache__xadd",
            "mcp__redis-cache__xdel",
            "mcp__redis-cache__xgroup_create",
            "mcp__redis-cache__xgroup_destroy",
            "mcp__redis-cache__xreadgroup",
            "mcp__redis-cache__xack",
            "mcp__redis-cache__zadd",
            "mcp__redis-cache__zrem",
            "mcp__redis-cache__sadd",
            "mcp__redis-cache__srem",
            "mcp__redis-queue__json_set",
            "mcp__redis-queue__json_del",
            "mcp__redis-queue__lpush",
            "mcp__redis-queue__rpush",
            "mcp__redis-queue__lpop",
            "mcp__redis-queue__rpop",
            "mcp__redis-queue__lrem",
            "mcp__redis-queue__hset",
            "mcp__redis-queue__hdel",
            "mcp__redis-queue__set_vector_in_hash",
            "mcp__redis-queue__delete",
            "mcp__redis-queue__expire",
            "mcp__redis-queue__rename",
            "mcp__redis-queue__create_vector_index_hash",
            "mcp__redis-queue__publish",
            "mcp__redis-queue__subscribe",
            "mcp__redis-queue__psubscribe",
            "mcp__redis-queue__unsubscribe",
            "mcp__redis-queue__set",
            "mcp__redis-queue__xadd",
            "mcp__redis-queue__xdel",
            "mcp__redis-queue__xgroup_create",
            "mcp__redis-queue__xgroup_destroy",
            "mcp__redis-queue__xreadgroup",
            "mcp__redis-queue__xack",
            "mcp__redis-queue__zadd",
            "mcp__redis-queue__zrem",
            "mcp__redis-queue__sadd",
            "mcp__redis-queue__srem",
            "Monitor",
            "Workflow"
        ],
        "additionalDirectories": ["/tmp", "/private/tmp"]
    },
    "env": {
        "BASH_DEFAULT_TIMEOUT_MS": "600000"
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
                    }
                ]
            },
            {
                "matcher": "Write|Edit|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-write.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rules-gate.sh"
                    }
                ]
            },
            {
                "matcher": "mcp__mongodb__.*|mcp__redis-cache__.*|mcp__redis-queue__.*|WebSearch|WebFetch",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-session.sh"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Read",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rules-gate.sh"
                    }
                ]
            },
            {
                "matcher": "Write|Edit|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
                        "timeout": 120
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/context-hint.sh"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify.sh",
                        "timeout": 600
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "startup|clear",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/roster.sh"
                    }
                ]
            },
            {
                "matcher": "startup|resume|clear|compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify.sh"
                    }
                ]
            }
        ]
    }
}
