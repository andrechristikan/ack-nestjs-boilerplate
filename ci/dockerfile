# Build stage base
FROM node:26.13.0-alpine AS base
LABEL maintainer="andrechristikan@gmail.com"
# pnpm version is pinned via the "packageManager" field in package.json
RUN npm install -g corepack && corepack enable
WORKDIR /app

# Stage to install all dependencies and build the app
FROM base AS builder
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    --mount=type=cache,id=pnpm-cache,target=/root/.cache/pnpm \
    set -x && pnpm install --frozen-lockfile --ignore-scripts

COPY . .

RUN pnpm generate
RUN pnpm build
# apis and migrate run as the host owner of .env, so every file they read is world-readable whatever mode the checkout gave it.
RUN chmod -R a+rX dist prisma package.json

# Migrate stage: pushes the schema. Calls the Prisma CLI through node because the corepack pnpm shim needs a writable home, which a host uid has not.
FROM builder AS migrate
CMD ["node", "node_modules/prisma/build/index.js", "db", "push", "--skip-generate"]

# Main Stage
FROM base AS main
ENV NODE_ENV=production
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    --mount=type=cache,id=pnpm-cache,target=/root/.cache/pnpm \
    set -x && pnpm install --frozen-lockfile --prod --ignore-scripts

# Copy only necessary files from previous stages
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./package.json

# Create non-root user for security
RUN addgroup -S ec2-user && adduser -S ec2-user -G ec2-user && touch .env
USER ec2-user

EXPOSE 3000

# Add healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/api/public/hello

CMD ["node", "dist/main.js"]
