APP_NAME=ACKNestJs
APP_ENV=local
APP_ENCRYPTION_SECRET=<base64url64Characters>

FRONTEND_BASE_URL=https://example.com
FRONTEND_NAME=ACKNestJs

EMAIL_NO_REPLY_ADDRESS=<emailAddress>
EMAIL_SUPPORT_ADDRESS=<emailAddress>

APP_HTTP_HOST=localhost
APP_HTTP_PORT=3000
APP_HTTP_TRUSTED_PROXIES=<commaSeparatedTrustedProxies>

LOGGER_ENABLED=true
LOGGER_LEVEL=debug
LOGGER_FILE_ENABLED=true
LOGGER_PRETTY_ENABLED=true
LOGGER_ACCESS_LOG_ENABLED=false

REQUEST_CORS_ALLOWED_ORIGINS=*

DATABASE_URL=mongodb://localhost:27017/ACKNestJs?retryWrites=true&w=majority&replicaSet=rs0&authSource=admin
DATABASE_DEBUG_ENABLED=true

AUTH_JWT_ISSUER=https://example.com
AUTH_JWT_AUDIENCE=ACKNestJs

AUTH_JWT_ACCESS_TOKEN_JWKS_URI=http://localhost:3011/.well-known/access-jwks.json
AUTH_JWT_ACCESS_TOKEN_KID=<keyId>
AUTH_JWT_ACCESS_TOKEN_PRIVATE_KEY=<base64PemBody>
AUTH_JWT_ACCESS_TOKEN_PUBLIC_KEY=<base64PemBody>

AUTH_JWT_REFRESH_TOKEN_JWKS_URI=http://localhost:3011/.well-known/refresh-jwks.json
AUTH_JWT_REFRESH_TOKEN_KID=<keyId>
AUTH_JWT_REFRESH_TOKEN_PRIVATE_KEY=<base64PemBody>
AUTH_JWT_REFRESH_TOKEN_PUBLIC_KEY=<base64PemBody>

MFA_TOTP_ISSUER=ACKNestJsTOTPFactor
MFA_TOTP_ENCRYPTION_SECRET=<base64url64Characters>
MFA_PASSKEY_RP_ID=localhost
MFA_PASSKEY_ORIGINS=http://localhost:3000

AUTH_SOCIAL_GOOGLE_CLIENT_ID=<googleClientId>

AUTH_SOCIAL_APPLE_CLIENT_IDS=<commaSeparatedAppleClientIds>

AWS_S3_ACCESS_KEY_ID=<awsAccessKeyId>
AWS_S3_SECRET_ACCESS_KEY=<awsSecretAccessKey>
AWS_S3_IAM_PRINCIPAL_ARN=<awsIamPrincipalArn>
AWS_S3_REGION=<awsRegion>
AWS_S3_ENDPOINT=<httpsUrlNoTrailingSlash>
AWS_S3_PUBLIC_BUCKET=<s3BucketName>
AWS_S3_PUBLIC_CDN_URL=<httpsUrlNoTrailingSlash>
AWS_S3_PRIVATE_BUCKET=<s3BucketName>
AWS_S3_PRIVATE_CDN_URL=<httpsUrlNoTrailingSlash>

AWS_SES_ACCESS_KEY_ID=<awsAccessKeyId>
AWS_SES_SECRET_ACCESS_KEY=<awsSecretAccessKey>
AWS_SES_IDENTITY_ARN=<awsSesIdentityArn>
AWS_SES_REGION=<awsRegion>
AWS_SES_ENDPOINT=<httpsUrlNoTrailingSlash>

REDIS_CACHE_URL=redis://localhost:6380/0

REDIS_QUEUE_URL=redis://localhost:6379/0

SENTRY_DSN=<sentryDsnUrl>
SENTRY_TRACES_SAMPLE_RATE=0.3
SENTRY_PROFILES_SAMPLE_RATE=0.3

FIREBASE_PROJECT_ID=<firebaseProjectId>
FIREBASE_CLIENT_EMAIL=<firebaseClientEmail>
FIREBASE_PRIVATE_KEY=<firebasePrivateKeyPem>
